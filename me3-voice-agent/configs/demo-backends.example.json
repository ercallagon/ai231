    "streaming": false,
    "concurrency": 1,
    "timeout_seconds": 60,
    "max_audio_seconds": 30,
    "allow_live": false,
    "request_limit": null,
    "allow_private_http": false,
    "voice": "",
    "language": "",
    "transcription_mode": "prompt"
  },
  "tts": {
    "backend": "external",
    "protocol": "vllm-qwen-tts-v1",
